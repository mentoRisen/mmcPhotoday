# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# catalog import — operator data and generated public assets
/public/catalog/
/import/**/*.json
!/import/**/example-*.json
/import/**/*.jpg
/import/**/*.jpeg
/import/**/*.png
!/import/**/example-*.jpg
!/import/**/example-*.jpeg
!/import/**/example-*.png
