# Example nginx reverse-proxy config for MMC Photoday.
# Copy to /etc/nginx/sites-available/photoday.minimoviecon.sk, adjust, then:
#   ln -s /etc/nginx/sites-available/photoday.minimoviecon.sk /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# TLS is typically added afterwards with certbot (--nginx).

upstream photoday_upstream {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name photoday.minimoviecon.sk;

    # Long-cache immutable Next.js build assets.
    location /_next/static/ {
        proxy_pass http://photoday_upstream;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Application (SSR, API routes, everything else).
    location / {
        proxy_pass http://photoday_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}
