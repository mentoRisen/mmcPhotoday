{
  "name": "mmc-photoday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/.bin/tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "import:catalog": "node --env-file=.env ./node_modules/.bin/tsx scripts/import-catalog.ts",
    "import:catalog:clear": "node --env-file=.env ./node_modules/.bin/tsx scripts/clear-catalog.ts",
    "import:catalog:reimport": "npm run import:catalog:clear && npm run import:catalog",
    "photographers:set-login-hashes": "node --env-file=.env ./node_modules/.bin/tsx scripts/set-photographer-login-hashes.ts",
    "test": "vitest run",
    "test:email": "node --env-file=.env ./node_modules/.bin/tsx scripts/test-email.ts",
    "service": "./scripts/service.sh",
    "service:start": "./scripts/service.sh start",
    "service:stop": "./scripts/service.sh stop",
    "service:restart": "./scripts/service.sh restart",
    "service:status": "./scripts/service.sh status",
    "service:logs": "./scripts/service.sh logs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "mysql2": "^3.15.3",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
