# MySQL connection string used by Drizzle / mysql2.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://photoday:changeme@127.0.0.1:3306/photoday"

# Public site URL (gallery image URLs written by  `npm run import:catalog`).
# Production: https://photoday.minimoviecon.sk
BASE_URL="http://localhost:3002"

# Port the Next.js server listens on (used in production via PM2).
PORT=3002

# SMTP settings for src/email (used by npm run test:email and future notifications).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@minimoviecon.sk"
SMTP_PASS="changeme"
EMAIL_FROM="MMC Photoday <noreply@minimoviecon.sk>"

# Organizer inbox for new cosplayer application notifications.
EMAIL_ORGANIZER_TO="organizer@minimoviecon.sk"

# Optional: redirect all outgoing mail to this address (dev/staging).
# Prepends a [TESTING] banner with the original `to` recipient.
# EMAIL_TESTING_TO="lukas.zemcak@gmail.com"
